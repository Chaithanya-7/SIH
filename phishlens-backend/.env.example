# PhishLens backend configuration. Copy this file to .env and use unique secrets.
PORT=3001
NODE_ENV=development

# Comma-separated dashboard origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3005

# Required for service-to-service API access (do not use a source-controlled default).
PHISHLENS_API_KEY=replace-with-a-long-random-secret

# Never enable this in production. The existing dashboard identity form is a
# local demo flow; it does not yet obtain and verify a Google ID token.
ENABLE_DEMO_IDENTITY=false

# Detection provider. 'native' (default, zero-cost) uses PhishLens' own MQL rule
# engine + NLP + forensics pipeline only and never calls out to an external
# service. Set to 'sublime' to ALSO attempt an external Sublime instance as
# optional, informational supplementary enrichment - it is never a hard
# dependency; PhishLens' own scored verdict never depends on it responding.
DETECTION_PROVIDER=native
DETECTION_ENDPOINT=http://localhost:8000
SUBLIME_API_KEY=

# Threat intelligence. Open indicator feeds (abuse.ch URLhaus/ThreatFox/Feodo,
# OpenPhish, Spamhaus DROP) are downloaded and matched entirely on this machine:
# no API key, no paid tier, and no indicator from your mail is ever sent to a
# third-party reputation service. Set AUTO_SYNC=false for an installation that
# must never reach out; detection then uses whatever is already stored locally.
# DISABLED_FEEDS takes comma-separated feed ids (urlhaus, openphish, feodo,
# threatfox, spamhaus_drop) - review each feed's licence via
# GET /api/threat-intelligence before commercial deployment.
THREAT_INTEL_AUTO_SYNC=true
THREAT_INTEL_SYNC_HOURS=6
THREAT_INTEL_DISABLED_FEEDS=

# SMTP ingestion is disabled by default. Enable it only for a trusted sender and
# retain loopback binding unless a protected network boundary is configured.
ENABLE_SMTP_INGESTION=false
SMTP_BIND_HOST=127.0.0.1
SMTP_LISTEN_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_MAX_MESSAGE_BYTES=10485760

# IMAP mailbox polling. Enabling this is what makes PhishLens actually watch a
# mailbox; with it off, only messages explicitly submitted to the API are
# examined. Check GET /api/ingestion to see which entry paths are live.
IMAP_ENABLED=false
IMAP_USER=
IMAP_PASSWORD=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# Keep certificate validation enabled. Set true only for a controlled lab IMAP
# server that uses a private/self-signed certificate.
IMAP_ALLOW_INVALID_CERT=false

# Gmail API ingestion. Create an OAuth client in your own Google Cloud project;
# nothing is hosted by PhishLens. Push delivery additionally needs a Pub/Sub
# topic whose push subscription points at /api/webhooks/gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# Gmail remediation remains disabled/simulated until an OAuth-backed integration
# is configured and its provider read-back verification succeeds.
REMEDIATION_MODE=simulation
MAILBOX_PROVIDER=gmail
