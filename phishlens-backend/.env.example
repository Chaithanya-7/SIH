# PhishLens backend configuration. Copy this file to .env and use unique secrets.
PORT=3001
NODE_ENV=development

# Comma-separated dashboard origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3005

# Required for service-to-service API access (do not use a source-controlled default).
PHISHLENS_API_KEY=replace-with-a-long-random-secret

# Never enable this in production. The existing dashboard identity form is a
# local demo flow; it does not yet obtain and verify a Google ID token.
ENABLE_DEMO_IDENTITY=false

# Detection provider
DETECTION_PROVIDER=sublime
DETECTION_ENDPOINT=http://localhost:8000
SUBLIME_API_KEY=

# SMTP ingestion is disabled by default. Enable it only for a trusted sender and
# retain loopback binding unless a protected network boundary is configured.
ENABLE_SMTP_INGESTION=false
SMTP_BIND_HOST=127.0.0.1
SMTP_LISTEN_PORT=2525
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_MAX_MESSAGE_BYTES=10485760

# Keep certificate validation enabled. Set true only for a controlled lab IMAP
# server that uses a private/self-signed certificate.
IMAP_ALLOW_INVALID_CERT=false

# Gmail remediation remains disabled/simulated until an OAuth-backed integration
# is configured and its provider read-back verification succeeds.
REMEDIATION_MODE=simulation
MAILBOX_PROVIDER=gmail
