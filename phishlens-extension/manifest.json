{
  "manifest_version": 3,
  "name": "PhishLens \u2014 Threat Shield",
  "version": "1.2.0",
  "description": "Examines webmail in your browser before you open it, and shows PhishLens detections.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://127.0.0.1:3001/*",
    "https://mail.google.com/*",
    "https://outlook.live.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishLens Shield"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "phishlens@phishlens.local",
      "strict_min_version": "115.0"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*",
        "https://outlook.live.com/*",
        "https://outlook.office.com/*",
        "https://outlook.office365.com/*"
      ],
      "js": [
        "mail-providers.js",
        "content-gmail.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
