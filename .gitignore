*.log
**/*.log
dist/
# Builds go to dist-<version> when Windows holds a lock on dist/win-unpacked,
# which it does after most builds. Same output, so the same rule applies.
dist-*/
**/dist/
.vscode/
.idea/
.npm-cache/

# The extension's provisioned settings carry this machine's API key.
#
# The desktop application writes it into the extension folder so the browser can
# be handed a copy that needs no configuration. It is per-install and must never
# be committed - a key in the repository is a key shared by everyone who clones
# it. The file is untracked rather than merely ignored, because ignoring a file
# git already follows changes nothing.
phishlens-extension/provisioned.js

# The browser extension's signing key and the packed extension it signs.
#
# A .pem here is the private key that identifies this extension. Committed, it
# becomes the key of everyone who clones the repository, and anyone holding it
# can publish an update that browsers accept as genuine. The .crx is built from
# the source in this repository and does not belong in it.
*.pem
*.crx

# Generated forensic reports. These describe real messages belonging to whoever
# ran the tool, so they are output, not source.
report.pdf
PhishLens_Report_*.pdf

# Planning archives dropped in the working directory.
*architecture-v*.zip
