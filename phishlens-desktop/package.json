{
  "name": "phishlens-desktop",
  "version": "1.0.0",
  "description": "PhishLens desktop application - the full SOC investigation console, installed on the workstation and registered as the handler for phishlens:// deep links from the browser extension.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder"
  },
  "license": "ISC",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.phishlens.desktop",
    "productName": "PhishLens",
    "files": [
      "main.js",
      "preload.js",
      "setup.html",
      "renderer/**"
    ],
    "extraResources": [
      {
        "from": "../phishlens-dashboard/dist",
        "to": "dashboard"
      }
    ],
    "protocols": [
      {
        "name": "PhishLens",
        "schemes": ["phishlens"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
